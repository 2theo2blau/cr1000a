
config interface 'wan'
	option dhcp_timeout '90'
	option macclone_enable '0'
	option disabled '0'
	option proto 'dhcp'
	option ifname 'eth1'
	option peerdns '1'

config interface 'wan6'
	option AutoConfigure '0'
	option delegate_prefix '0'
	option delegate_prefix_len '0'
	option ipv6 '1'
	option LinklocalAddr 'fe80::0000:0000:0000:0000'
	option prefix '0'
	option prefix_len '0'
	option proto 'dhcpv6'
	option ip6addr '0'
	option ip6prefix '0'
	option DHCP_IAPD '1'
	option DNS_Auto '0'
	option DNSlist '0'
	list dns ''
	option gateway '0'
	option LifeTimestamp '0'
	option ip6gw '0'
	option valid_time '0'
	option addr '0'

config interface 'lan'
	option ipaddr '192.168.1.1'
	option netmask '255.255.255.0'
	option ifname 'eth0'

config interface 'lan1'
	option ipaddr '192.168.200.1'
	option netmask '255.255.255.0'

config interface 'lan2'
	option ipaddr '192.168.150.1'
	option netmask '255.255.255.0'

