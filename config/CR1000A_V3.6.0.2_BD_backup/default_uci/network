
config interface 'wan'
	option dhcp_timeout '90'
	option macclone_enable '0'
	option disabled '0'
	option proto 'dhcp'
	option peerdns '1'

config interface 'wan6'
	option AutoConfigure '0'
	option delegate_prefix '0'
	option delegate_prefix_len '0'
	option ipv6 '1'
	option proto 'dhcpv6'
	option ip6addr '0'
	option ip6gw '0'
	option ip6prefix '0'
	option DHCP_IAPD '1'
	option peerdns '1'
	option disabled '0'

config interface 'lan'
	option ipaddr '192.168.1.1'
	option netmask '255.255.255.0'
	option ifname 'eth0'

